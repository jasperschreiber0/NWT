# Telegram alerting (notifier.py) — the live alerting channel. Discord is
# dead; if either var below is missing, notifier.py silently no-ops.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_from_userinfobot
