NWT_DB_DSN=postgresql://user:pass@localhost/nwt_agents
NWT_ALPACA_BASE_URL=https://paper-api.alpaca.markets
NWT_ALPACA_DATA_URL=https://data.alpaca.markets
NWT_ALPACA_KEY_ID=your_key
NWT_ALPACA_SECRET_KEY=your_secret
OPENAI_API_KEY=your_openai_key
OPENAI_PRESCREENER_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_CONVICTION_MODEL=gpt-4.1-2025-04-14
